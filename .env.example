# Copie para .env.local e preencha (gitignored).
# Alternativa: defina as mesmas variáveis no ambiente da máquina (Windows / Netlify).
# O processo da máquina tem precedência sobre os arquivos.
# Reinicie o Metro / faça um novo deploy depois de mudar EXPO_PUBLIC_*.

# Usa repositórios mockados quando "true". Vazio: mock só em dev; em build de produção usa a API real.
EXPO_PUBLIC_USE_MOCKS=true

# URL base da API já com /api (usada quando EXPO_PUBLIC_USE_MOCKS=false).
# Local: http://localhost:5080/api | Emulador Android: http://10.0.2.2:5080/api
# Produção: https://sua-api.prod.com.br
EXPO_PUBLIC_API_URL=

# API key do Google Maps (Maps SDK for Android) — build nativo (`npx expo run:android`).
# Não funciona no Expo Go (SDK 57). Crie em https://console.cloud.google.com/apis/credentials
# Habilite "Maps SDK for Android" e restrinja ao package com.nexoraprism.encontrame + SHA-1 debug.
# Não é necessária no deploy web (Netlify).
GOOGLE_MAPS_API_KEY=

# API key da Maps JavaScript API (web). Pública no bundle — restrinja a HTTP referrers
# (localhost e o domínio de produção, ex. https://seu-site.netlify.app/*).
# Não reutilize a chave restrita ao Android.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Client ID web do OAuth 2.0 (Google Cloud → Credenciais). Público no bundle.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Chave fixa do app (header X-App-Key). Deve coincidir com AppKey:Value / AppKey__Value da API.
EXPO_PUBLIC_APP_KEY=

# Alerta de emergência: envio ao servidor (POST /EmergencyAlert) ao fim da contagem de 10 s.
# Vazio: ligado em dev (mock), desligado em produção. Só ligue ("true") quando a API receber o
# alerta e devolver alertId + receivedAt. Desligado, a contagem só abre o telefone com o 190.
EXPO_PUBLIC_ENABLE_EMERGENCY_ALERT=

# Só para o mock (dev): "true" simula falha no envio do alerta (tela "não confirmado").
EXPO_PUBLIC_MOCK_EMERGENCY_FAIL=

# Notificações vindas do servidor (casos perto, novos cadastros da região, "Acompanhar").
# Vazio: ligado em dev (mock), desligado em produção. Só ligue ("true") quando a API guardar o
# aparelho (POST /Notification/device) e enviar os avisos. O lembrete de cadastros salvos no
# aparelho funciona sem esta variável.
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=

# Relato completo de avistamento ("Eu vi essa pessoa") e a tela "Meus relatos" (versão de evolução).
# Vazio: ligado em dev (mock), desligado em produção. Só ligue ("true") quando a API tiver
# POST /SightingReport e GET /SightingReport/mine (docs/evolucao/CONTRATOS-API.md).
# Desligado, o app usa o registro simples de avistamento (POST /MissingPerson/{id}/last-seen).
EXPO_PUBLIC_ENABLE_SIGHTING_REPORTS=

# Só para o mock (dev): "true" simula falha no envio do relato (mensagem "não confirmado").
EXPO_PUBLIC_MOCK_SIGHTING_FAIL=

# Linha do tempo completa do caso vinda da API (GET /MissingPerson/{id}/timeline) — versão de evolução.
# Vazio: ligada em dev (mock), desligada em produção. Desligada, a linha do tempo é montada com o cadastro e o
# histórico de avistamentos que a API de hoje já devolve.
EXPO_PUBLIC_ENABLE_CASE_TIMELINE=

# Rede inteligente de busca (raio dos alertas, sugestão de região, ampliação e "teia" no Painel da equipe).
# Vazio: ligada em dev (mock), desligada em produção.
EXPO_PUBLIC_ENABLE_SEARCH_NETWORK=

# Sugestões da IA para a equipe (sempre com decisão humana). Vazio: ligada em dev (mock), desligada em produção.
EXPO_PUBLIC_ENABLE_AI_ASSIST=

# "Quero ajudar" (voluntariado). Vazio: ligado em dev (mock), desligado em produção.
EXPO_PUBLIC_ENABLE_VOLUNTEERS=

# Encontra-me Vision (rede de câmeras participantes, painel do responsável e ambiente institucional).
# Vazio: ligado em dev com dados fictícios, desligado em produção. Só ligar com a API /Vision/*, convênios e
# avaliação jurídica (docs/evolucao/VISION.md).
EXPO_PUBLIC_ENABLE_VISION=

# Endereço público do app web, sem barra no fim (ex.: https://seu-site.com.br).
# Quando preenchido, o texto de "Divulgar este caso" inclui o link da página do caso.
EXPO_PUBLIC_WEB_URL=
