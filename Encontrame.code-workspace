{
  "folders": [
    {
      "name": "Front",
      "path": "."
    },
    {
      "name": "Back",
      "path": "../../backend/EncontrameApi"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/bin": true,
      "**/obj": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "ms-dotnettools.csdevkit",
      "expo.vscode-expo-tools"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Encontrame: API + App",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["start"],
        "cwd": "${workspaceFolder:Front}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "preLaunchTask": "run-api",
        "skipFiles": ["<node_internals>/**"],
        "presentation": {
          "order": 1,
          "group": "encontrame"
        }
      },
      {
        "name": "Expo",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["start"],
        "cwd": "${workspaceFolder:Front}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "skipFiles": ["<node_internals>/**"]
      }
    ],
    "compounds": [
      {
        "name": "Encontrame: API + App (debug)",
        "configurations": [
          { "folder": "Back", "name": "API" },
          { "folder": "Front", "name": "Expo" }
        ],
        "stopAll": true,
        "presentation": {
          "order": 2,
          "group": "encontrame"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "run-api",
        "type": "shell",
        "command": "cmd /c start-api.cmd",
        "options": {
          "cwd": "${workspaceFolder:Back}",
          "env": {
            "ASPNETCORE_ENVIRONMENT": "Development"
          }
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "dotnet-api",
          "pattern": {
            "regexp": "^$"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Now listening on:"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "focus": false,
          "clear": true
        }
      }
    ]
  }
}
